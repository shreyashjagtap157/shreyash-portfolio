{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "shreyash-portfolio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-10-26",
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "logs": {
      "head_sampling_rate": 1
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.05
    }
  },
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ],
    "not_found_handling": "single-page-application"
  }
}
