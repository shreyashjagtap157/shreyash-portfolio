{
  "compilerOptions": {
    "target": "ES2022", "lib": ["ES2023","DOM","DOM.Iterable"], "module": "ESNext",
    "moduleResolution": "bundler", "jsx": "react-jsx", "strict": true,
    "resolveJsonModule": true, "isolatedModules": true, "skipLibCheck": true,
    "noUnusedLocals": true, "noUnusedParameters": true, "noEmit": true, "types": ["vite/client", "node"]
  },
  "include": ["src", "tests"]
}
